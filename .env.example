# 复制为 .env 后修改；或直接运行 deploy.sh 自动生成（含随机强密码）
# Web 界面监听。默认 0.0.0.0:8080；若用本机 nginx/Caddy 做 HTTPS 反代，改为 WEB_BIND=127.0.0.1
WEB_BIND=0.0.0.0
WEB_PORT=8080

# VPS 公网 IP（必填，WebRTC 用）。deploy.sh 会自动探测
PUBLIC_IP=203.0.113.10

# 登录密码：user 为访客密码，admin 为管理员密码（务必改掉示例）
NEKO_USER_PASSWORD=change-me-user
NEKO_ADMIN_PASSWORD=change-me-admin

# 画面尺寸（宽x高@帧率）。手机竖屏可用 720x1280@30；带宽紧张可降到 1024x576@25
NEKO_SCREEN=1280x720@30
